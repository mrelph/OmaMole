{
  "name": "omamole",
  "version": "0.2.0",
  "description": "Scan, clean, and tune an Arch Linux / Omarchy system — a Hyprland-native housekeeping app.",
  "author": "Mark Relph",
  "license": "MIT",
  "main": "dist-electron/main.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -k \"tsc -p tsconfig.electron.json --watch\" \"vite --host 127.0.0.1\" \"wait-on tcp:5173 file:dist-electron/main.js && VITE_DEV_SERVER_URL=http://127.0.0.1:5173 ./scripts/electron.sh .\"",
    "build": "tsc -p tsconfig.electron.json && vite build",
    "start": "./scripts/electron.sh .",
    "preview": "pnpm build && ./scripts/electron.sh .",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "test": "vitest run",
    "lint:helper": "shellcheck helper/omamole-helper"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^10.0.5",
    "electron": "^43.7.7",
    "typescript": "^5.9.3",
    "vite": "^6.4.3",
    "vitest": "^3.2.7",
    "wait-on": "^9.5.1"
  }
}
